APP_VERSION=1.0.0
FLASK_DEBUG=0
SECRET_KEY=troque-por-uma-chave-forte
JWT_SECRET=troque-por-outra-chave-forte
ADMIN_SECRET=
HOTMART_WEBHOOK_TOKEN=
# Local/teste: sqlite:///advogo_seguro.db
# Produção Render: use a URL PostgreSQL fornecida pelo banco
DATABASE_URL=sqlite:///advogo_seguro.db
ALLOWED_ORIGINS=
JWT_TTL_HORAS=12
SENHA_MIN_CARACTERES=10

# Recuperação de senha do escritório por e-mail
PUBLIC_BASE_URL=https://SEU-DOMINIO-AQUI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=tls

# LGPD / Privacidade
PRIVACY_CONTACT_EMAIL=
# 0 = nenhuma limpeza de logs é executada sem ação explícita.
LGPD_RETENCAO_LOGS_DIAS=0

# Comercial
# Exemplo: {"123456":"profissional","234567":"escritorio","345678":"blindagem","456789":"corporativo"}
HOTMART_PLAN_MAP={}
# Somente dígitos com DDI/DDD, exemplo: 5561999999999
COMMERCIAL_WHATSAPP=
COMMERCIAL_EMAIL=
